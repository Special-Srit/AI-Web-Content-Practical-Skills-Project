# macOS
.DS_Store
._*

# editors
.vscode/
.idea/
*.swp

# node (build step added 2026-08-06 — nyangbti's React/Vite app)
node_modules/
package-lock.json
dist/

# secrets / local config
.env
.env.local

# AI tool local state — but keep role agent definitions version-controlled
.claude/*
!.claude/agents/
.aider*

# scratch
tmp/
*.log

# generated deck — rebuild with presentation/build_deck.py, don't track the binary.
# Each rebuild would otherwise add a new multi-MB blob to permanent history.
*.pptx

# lossless image masters, kept locally only. The committed .jpg versions are what
# build_deck.py uses (10.2MB PNG -> 1.6MB JPEG at q82, visually equivalent at
# deck size). Back these up outside git if they matter.
nyangbti/assets/*.png
